<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <SupportedOSPlatformVersion>net8.0</SupportedOSPlatformVersion>
        <UseMaui>false</UseMaui>
        <!-- When building a smoke test executable, set SmokeTest=true on the command line -->
        <SmokeTest Condition=" '$(SmokeTest)' == '' ">false</SmokeTest>
        <OutputType Condition=" '$(SmokeTest)' == 'true' ">Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="sqlite-net-pcl" Version="1.8.116" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
        <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    </ItemGroup>

</Project>
