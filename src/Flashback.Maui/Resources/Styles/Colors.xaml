<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    
    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="Secondary">#030024</Color>
    <Color x:Key="Tertiary">#E8A2AF</Color>

    <Color x:Key="PrimaryVariant">#0050FF</Color>
    <Color x:Key="SecondaryVariant">#00105B</Color>

    <Color x:Key="Background">#FFFFFF</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Error">#B00020</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="OnSecondary">#FFFFFF</Color>
    <Color x:Key="OnTertiary">#000000</Color>
    <Color x:Key="OnBackground">#000000</Color>
    <Color x:Key="OnSurface">#000000</Color>
    <Color x:Key="OnError">#FFFFFF</Color>

</ResourceDictionary>
